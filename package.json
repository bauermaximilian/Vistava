{
  "name": "vistava",
  "desktopName": "com.bauermaximilian.vistava",
  "version": "1.0.0-beta.3",
  "description": "A no-nonsense media file browser",
  "license": "GPL-3.0-or-later",
  "author": "Maximilian Bauer",
  "homepage": "https://vistava.net",
  "os": [
    "win32",
    "linux"
  ],
  "type": "module",
  "main": "src/Vistava.js",
  "scripts": {
    "preinstall": "node ./src/DotNetChecker.js --check-sdk",
    "prebuild:windows": "dotnet publish ./service/Vistava.Service.csproj -p:PublishProfile=Windows",
    "prebuild:linux": "dotnet publish ./service/Vistava.Service.csproj -p:PublishProfile=Linux",
    "prebuild": "npm run prebuild:windows && npm run prebuild:linux",
    "build:windows": "npm run prebuild:windows && electron-builder -w",
    "build:linux-debug": "npm run prebuild:linux && env DEBUG='@malept/flatpak-bundler' electron-builder -l",
    "build:linux": "npm run prebuild:linux && electron-builder -l",
    "build": "electron-builder -wl",
    "prestart": "npm run prebuild",
    "start": "electron . --debug-mode",
    "start:service": "dotnet run --project ./service/Vistava.Service.csproj -- --allowCors=true --port=42069 --debug=true --disableHttps=true"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "productName": "Vistava",
    "appId": "com.bauermaximilian.vistava",
    "copyright": "Copyright (C) 2026 Maximilian Bauer",
    "asar": "false",
    "electronLanguages": "en-US",
    "artifactName": "${name}-${os}-${version}.${ext}",
    "files": [
      "src/*.js",
      {
        "from": "service/bin/Publish/${os}",
        "to": "bin/${os}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      "README.md",
      "COPYING"
    ],
    "linux": {
      "icon": "build/icons/",
      "category": "Graphics;AudioVideo",
      "mimeTypes": [
        "inode/directory"
      ],
      "maintainer": "Maximilian Bauer",
      "target": [
        "tar.bz2",
        "pacman",
        "flatpak"
      ],
      "syncDesktopName": true
    },
    "pacman": {
      "depends": [
        "c-ares",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator-gtk3",
        "ffmpeg"
      ]
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "license": "COPYING",
      "useWaylandFlags": true,
      "modules": [
        {
          "name": "dav1d",
          "buildsystem": "meson",
          "sources": [
            {
              "type": "git",
              "url": "https://code.videolan.org/videolan/dav1d.git"
            }
          ]
        },
        {
          "name": "x264",
          "sources": [
            {
              "type": "git",
              "url": "https://code.videolan.org/videolan/x264.git"
            }
          ],
          "config-opts": [
            "--enable-shared"
          ]
        },
        {
          "name": "ffmpeg",
          "sources": [
            {
              "type": "git",
              "url": "https://git.ffmpeg.org/ffmpeg.git",
              "tag": "n8.1.1"
            }
          ],
          "config-opts": [
            "--enable-gpl",
            "--enable-libdav1d",
            "--enable-libx264",
            "--disable-static",
            "--disable-doc",
            "--enable-shared",
            "--disable-ffplay"
          ]
        }
      ],
      "finishArgs": [
        "--socket=x11",
        "--socket=wayland",
        "--share=ipc",
        "--share=network",
        "--filesystem=home:ro",
        "--filesystem=/run/udev:ro",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=com.canonical.AppMenu.Registrar",
        "--device=dri",
        "--device=input",
        "--socket=pulseaudio"
      ]
    },
    "win": {
      "target": [
        "zip", 
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${name}-${os}-setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "license": "COPYING",
      "oneClick": false,
      "perMachine": true,
      "uninstallDisplayName": "${productName}"
    }
  }
}
