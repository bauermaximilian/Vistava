{
  "name": "vistava",
  "desktopName": "net.vistava.vistava",
  "version": "1.0.0",
  "description": "A no-nonsense media browser",
  "license": "GPL-3.0-or-later",
  "author": "Maximilian Bauer",
  "homepage": "https://vistava.net",
  "os": [
    "win32",
    "linux"
  ],
  "type": "module",
  "main": "src/Vistava.js",
  "scripts": {
    "rebuild-icon": "cd build/icons && magick -background transparent -define 'icon:auto-resize=16,24,32,48,64,96,128,256,512' icon.svg icon.ico",
    "prebuild:windows": "dotnet publish ./service/Vistava.Service.csproj -p:PublishProfile=Windows",
    "prebuild:linux": "dotnet publish ./service/Vistava.Service.csproj -p:PublishProfile=Linux $PREBUILD_ARGS",
    "build:windows": "npm run prebuild:windows && node ./build/windows/get-ffmpeg.js && npm run prebuild:windows && electron-builder -w",   
    "build:linux": "npm run prebuild:linux && electron-builder --linux dir",
    "start": "npm run prebuild:windows && npm run prebuild:linux && electron . --debug-mode",
    "start:service": "dotnet run --project ./service/Vistava.Service.csproj -- --allowCors=true --port=42069 --debug=true --disableHttps=true"
  },
  "dependencies": {
    "7zip-min": "^3.0.1"
  },
  "devDependencies": {
    "7zip-min": "^3.0.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "productName": "Vistava",
    "appId": "net.vistava.vistava",
    "copyright": "Copyright (C) 2026 Maximilian Bauer",
    "asar": "false",
    "electronLanguages": "en-US",
    "artifactName": "${name}-${os}-${version}.${ext}",
    "files": [
      "src/*.js",
      {
        "from": "service/bin/Publish/${os}",
        "to": "bin/${os}",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraFiles": [
      "README.md",
      "COPYING"
    ],
    "linux": {
      "icon": "build/icons/",
      "category": "Graphics;AudioVideo",
      "mimeTypes": [
        "inode/directory"
      ],
      "maintainer": "Maximilian Bauer",
      "target": "dir",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "zip",
        "nsis"
      ],
      "extraResources": [
        {
          "from": "build/windows/ffmpeg/ffmpeg.exe",
          "to": "app/bin/win/ffmpeg.exe"
        },
        {
          "from": "build/windows/ffmpeg/ffprobe.exe",
          "to": "app/bin/win/ffprobe.exe"
        }
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "artifactName": "${name}-${os}-setup-${version}.${ext}",
      "deleteAppDataOnUninstall": true,
      "license": "COPYING",
      "oneClick": false,
      "perMachine": true,
      "uninstallDisplayName": "${productName}",
      "script": "build/windows/installer.nsi"
    }
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "electron-winstaller@5.4.0": true
  }
}
