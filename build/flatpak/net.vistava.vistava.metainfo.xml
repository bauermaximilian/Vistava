<component type="desktop-application">
  <id>net.vistava.vistava</id>
  
  <name>Vistava</name>
  <summary>A no-nonsense media browser</summary>
  
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
    <control>tablet</control>
  </supports>
  
  <description>
    <p>
      Vistava turns your media library into a peaceful, minimalist gallery - so you can focus on 
      what you actually care about.
    </p>
    <ul>
      <li>View your images and videos without distractions</li>
      <li>Move through your library with ease - via mouse, keyboard, touch screen, or gamepad</li>
      <li>Stream your media to any device with a web browser on your network - like a TV, smartphone, or VR headset</li>
      <li>View content from third-party sources with optional extensions</li>
    </ul>
    <p>
      Vistava is a free and open source. Share your feedback on the GitHub 
      Discussions page using the contact link below!
    </p>
  </description>

  <releases>
    <release version="1.1.0" date="2026-11-20">
      <url type="details">https://github.com/bauermaximilian/Vistava/releases/tag/v1.1.0</url>
      <description>
        <ul>
          <li>Add new home screen with links to media folders and installed extensions</li>
          <li>Improve application title bar and context menu</li>
          <li>Show media controls in gallery view by default</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-11-18">
      <url type="details">https://github.com/bauermaximilian/Vistava/releases/tag/v1.0.1</url>
      <description>
        <ul>
          <li>Fix bug that could turn video elements blue</li>
          <li>Fix bug which could cause video elements stay active in background</li>
          <li>Fix broken documentation link in application metainfo</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-11-10">
      <url type="details">https://github.com/bauermaximilian/Vistava/releases/tag/v1.0.0</url>
      <description>
        <p>The first stable release of Vistava.</p>
      </description>
    </release>
  </releases>

  <categories>
    <category>Graphics</category>
    <category>AudioVideo</category>
  </categories>

  <keywords>
    <keyword>gallery</keyword>
    <keyword>viewer</keyword>
    <keyword>accessibility</keyword>
    <keyword>media</keyword>
    <keyword>images</keyword>
    <keyword>videos</keyword>
    <keyword>masonry</keyword>
    <keyword>sharing</keyword>
  </keywords>

  <url type="homepage">https://vistava.net</url>
  <url type="help">https://vistava.net/docs.html</url>
  <url type="vcs-browser">https://github.com/bauermaximilian/Vistava</url>
  <url type="bugtracker">https://github.com/bauermaximilian/Vistava/issues</url>
  <url type="contact">https://github.com/bauermaximilian/Vistava/discussions</url>

  <content_rating type="oars-1.0" />

  <icon type="stock">net.vistava.vistava</icon>
  <icon type="remote">https://vistava.net/media/app-icon.svg</icon>

  <developer id="com.bauermaximilian">
    <name>Maximilian Bauer</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d8d8d8</color>
    <color type="primary" scheme_preference="dark">#1e1e1e</color>
  </branding>

  <provides>
    <mediatype>inode/directory</mediatype>
  </provides>

  <launchable type="desktop-id">net.vistava.vistava.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot.png</image>
      <caption>The main "gallery view" user interface</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot-player.png</image>
      <caption>The main "detail view" user interface of a video</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot-sharing.png</image>
      <caption>The sharing feature enabled, displaying a QR code to scan with another device</caption>
    </screenshot>
  </screenshots>
</component>