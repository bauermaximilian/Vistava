<component type="desktop-application">
  <id>net.vistava.vistava</id>
  
  <name>Vistava</name>
  <summary>A no-nonsense media browser</summary>
  
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>gamepad</control>
    <control>tablet</control>
  </supports>
  
  <description>
    <p>
      Vistava is a chill, minimalist viewer for images and videos. It makes browsing your media simple - on any device.
    </p>
    <ul>
      <li>Browse your image and video library in peace</li>
      <li>Navigate via mouse, keyboard, touch screen, or gamepad</li>
      <li>Share your media to a TV, smartphone, or VR headset within your network</li>
      <li>View content from third-party sources with optional extensions</li>
    </ul>
  </description>

  <releases>
    <release version="1.0.0" date="2026-11-10">
      <url type="details">https://github.com/bauermaximilian/Vistava/releases/tag/v1.0.0</url>
      <description>
        <p>The first stable release of Vistava.</p>
      </description>
    </release>
  </releases>

  <categories>
    <category>Graphics</category>
    <category>AudioVideo</category>
  </categories>

  <keywords>
    <keyword>gallery</keyword>
    <keyword>viewer</keyword>
    <keyword>accessibility</keyword>
    <keyword>media</keyword>
    <keyword>images</keyword>
    <keyword>videos</keyword>
    <keyword>masonry</keyword>
    <keyword>sharing</keyword>
  </keywords>

  <url type="homepage">https://vistava.net</url>
  <url type="help">https://vistava.net/docs</url>
  <url type="vcs-browser">https://github.com/bauermaximilian/Vistava</url>
  <url type="bugtracker">https://github.com/bauermaximilian/Vistava/issues</url>

  <content_rating type="oars-1.0" />

  <icon type="stock">net.vistava.vistava</icon>
  <icon type="remote">https://vistava.net/media/app-icon.svg</icon>

  <developer id="com.bauermaximilian">
    <name>Maximilian Bauer</name>
  </developer>

  <branding>
    <color type="primary" scheme_preference="light">#d8d8d8</color>
    <color type="primary" scheme_preference="dark">#1e1e1e</color>
  </branding>

  <provides>
    <mediatype>inode/directory</mediatype>
  </provides>

  <launchable type="desktop-id">net.vistava.vistava.desktop</launchable>
  <screenshots>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot.png</image>
      <caption>The main "gallery view" user interface</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot-player.png</image>
      <caption>The main "detail view" user interface of a video</caption>
    </screenshot>
    <screenshot type="default">
      <image>https://vistava.net/media/screenshot-sharing.png</image>
      <caption>The sharing feature enabled, displaying a QR code to scan with another device</caption>
    </screenshot>
  </screenshots>
</component>